# ─── 서버 ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── 저장소 (Supabase PostgreSQL / JSON) ─────────────
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/postgres
# JSON 파일 저장소(개발/테스트용):
DB_DRIVER=json

# ─── 인증 ────────────────────────────────────────────
AUTH_PROVIDER=local
# Production에서는 반드시 설정. dev-secret 폴백은 개발 전용.
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=21d

# Supabase Auth 활성화 시(계정 이관 완료 후 AUTH_PROVIDER=supabase):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-import-only

# ─── GameOps AI (선택) ──────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
# HF_TOKEN=your-huggingface-inference-token
# HF_MODEL=openai/gpt-oss-120b
