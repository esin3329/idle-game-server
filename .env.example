# ─── 서버 ───────────────────────────────────────────
# 서버 포트
PORT=3000
# 실행 환경 (development | production)
NODE_ENV=development

# ─── MySQL ──────────────────────────────────────────
# 앱 전용 사용자 사용 (root 접속 금지)
# 데이터베이스 이름
DB_NAME=idle_game
# MySQL 사용자 (root 아님)
DB_USER=gameuser
# MySQL 비밀번호 (변경 필수)
DB_PASSWORD=changeme
# MySQL 호스트 (Docker Compose 내부: mysql)
DB_HOST=mysql
# MySQL 포트
DB_PORT=3306
# MySQL root 비밀번호 (변경 필수)
MYSQL_ROOT_PASSWORD=changeme

# ─── 테스트 DB ───────────────────────────────────────
# 통합 테스트용 별도 DB (선택)
# DB_DRIVER=mysql DB_NAME=idle_game_test DB_PASSWORD=testpassword

# ─── JWT ────────────────────────────────────────────
# Production에서 반드시 설정. dev-secret 폴백은 개발 전용.
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
