{
  "name": "idle-game-server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:battle-seed": "tsx src/db/battle-seed.ts",
    "db:seed-operator": "tsx src/db/seed-operator.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:import-json": "tsx src/db/import-json.ts",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.1",
    "pino": "^10.3.1",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@vitest/expect": "^4.1.10",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "~5.7.0",
    "vitest": "^4.1.10"
  }
}
