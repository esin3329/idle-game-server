{
  "name": "idle-game-server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:cloudflare": "npm run build:admin && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "build:admin": "npm --prefix admin run build",
    "deploy:cloudflare": "npm run build:admin && wrangler deploy",
    "types:cloudflare": "wrangler types --strict-vars false --include-runtime false",
    "type-check": "tsc --noEmit",
    "type-check:cloudflare": "tsc --noEmit -p tsconfig.worker.json",
    "start": "node dist/index.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:battle-seed": "tsx src/db/battle-seed.ts",
    "db:seed-operator": "tsx src/db/seed-operator.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:import-json": "tsx src/db/import-json.ts",
    "clean": "rm -rf dist/",
    "db:migrate:postgres": "tsx src/db/postgres-migrate-cli.ts",
    "test:postgres": "tsx src/db/postgres-integration-check.ts",
    "db:import-auth": "tsx src/db/import-supabase-auth.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.1",
    "pg": "8.23.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "8.23.1",
    "@vitest/expect": "^4.1.10",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "17.6.0-beta.15",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "~5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "4.143.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "hyperid": {
      "uuid": "11.1.1"
    },
    "miniflare": {
      "sharp": "^0.35.5"
    }
  }
}
