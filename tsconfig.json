{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "dist", "admin", "src/__tests__", "vitest.config.ts", "drizzle.config.ts", "drizzle.postgres.config.ts", "src/worker.ts", "src/gameops-workflow.ts", "src/cloudflare-environment.ts", "worker-configuration.d.ts"]
}
