{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "idle-game-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "assets": {
    "directory": "./admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health", "/health/*", "/ready", "/metrics"]
  },
  "vars": {
    "API_ORIGIN": "https://replace-with-node-api.example.com"
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
